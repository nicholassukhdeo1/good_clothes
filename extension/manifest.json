{
  "manifest_version": 3,
  "name": "good_clothes",
  "version": "0.1.0",
  "description": "How worthy is this item to buy? A 0-100 score on materials, ethics, and ownership.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "*://*.ssense.com/*",
    "https://good-clothes-backend.onrender.com/*",
    "http://localhost:8000/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://*.ssense.com/*/product/*"],
      "js": ["prefs.js", "materials.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "good_clothes" }
}
